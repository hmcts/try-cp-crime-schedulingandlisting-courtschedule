# Optional local overrides for `./gradlew bootRun`. Copy to .env, which is gitignored:
#
#     cp .env.example .env
#
# You do not need one. `./gradlew bootRun` works on a clean checkout: it runs under the `local`
# Spring profile, whose defaults are in src/main/resources/application-local.yaml, and the import of
# this file is marked optional. A .env is for the values you want to differ from everyone else's.
#
# Precedence, lowest to highest:
#
#     application.yaml  <  application-local.yaml  <  .env  <  a real environment variable
#
# NEVER put a real credential in .env. Deployed environments take their secrets from the
# amp-try-slc-{env} key vault, mounted by Flux - never from a file in the working tree. Everything
# below is either a local-only default or published demo material.

# --- Postgres ---------------------------------------------------------------
# The container is published on 55432 rather than 5432 on purpose. A natively installed Postgres
# listening on 127.0.0.1:5432 shadows a Docker container published on the same port - the specific
# bind beats Docker's wildcard - and the app then fails with `role "postgres" does not exist`, which
# reads like a permissions problem but is a wrong-server problem.
#
#     docker run -d --name tin-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=tryitnow \
#       -p 55432:5432 postgres:16-alpine
#
# 55432 is already the `local` profile default, so uncomment this only to use a different port.
# POSTGRES_PORT=55432
# POSTGRES_HOST=localhost
# POSTGRES_DATABASE=tryitnow
# POSTGRES_USER=postgres
# POSTGRES_PASS=postgres

# --- Admin realm ------------------------------------------------------------
# Off by default locally, because the realm verifies against a real corporate Entra tenant and
# refuses to start without one. /admin/** answers 503 rather than being left unguarded. Set this
# false, with the ADMIN_* values filled in, to work on the recording pipeline itself.
# ADMIN_DISABLED=false
# ADMIN_TENANT_ID=
# ADMIN_AUDIENCE=
# ADMIN_ISSUER=
# ADMIN_JWKS_URI=

# --- Demo signing key -------------------------------------------------------
# Unset, the service generates an ephemeral key and logs a warning - correct locally, since tokens
# die with the process. Set it only to reproduce something that needs a stable key across restarts.
# DEMO_SIGNING_KEY_JWK={"kty":"RSA",...}

# --- Fixture seeding --------------------------------------------------------
# Committed fixtures are seeded on first boot for any URN with nothing published. Set false to see
# how a genuinely empty environment behaves.
# RECORDING_SEED_FIXTURES=false
