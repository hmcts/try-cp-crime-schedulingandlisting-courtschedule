# Template for the local .env. Copy it and let direnv load it:
#
#   cp .env.example .env          # .env and .envrc are already git-ignored
#   printf 'dotenv\n' > .envrc    # tells direnv to load .env
#   direnv allow
#
# Without direnv, export these in your shell before `./gradlew bootRun`, or put them in front of it.
# Everything the service reads is an environment variable with a default in application.yaml - there
# is no local Spring profile, and nothing here changes how a deployed environment behaves.
#
# NEVER commit .env. Deployed environments take their secrets from the amp-try-slc-{env} key vault,
# mounted by Flux. Every value below is a local-only default or published demo material.

# --- Postgres -----------------------------------------------------------------
# 55432, not the application.yaml default of 5432, and the reason matters. A natively installed
# Postgres listening on 127.0.0.1:5432 shadows a Docker container published on the same port - the
# specific bind beats Docker's wildcard - and the app then fails with
#
#   FATAL: role "postgres" does not exist
#
# which reads like a permissions problem and is really a wrong-server problem.
#
#   docker run -d --name tin-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=tryitnow \
#     -p 55432:5432 postgres:16-alpine
POSTGRES_PORT=55432
POSTGRES_HOST=localhost
POSTGRES_DATABASE=tryitnow
POSTGRES_USER=postgres
POSTGRES_PASS=postgres

# --- Admin realm ----------------------------------------------------------------
# The recording admin API verifies against a real corporate Entra tenant and refuses to start
# half-configured. true makes /admin/** answer 503 rather than leaving it unguarded, which is what
# you want unless you are working on the recording pipeline itself.
#
# To work on it, set ADMIN_DISABLED=false and fill in the four values below from the app
# registration. ADMIN_CLIENT_SECRET has no place here - this service validates tokens, it does not
# request them.
ADMIN_DISABLED=true
# ADMIN_TENANT_ID=
# ADMIN_AUDIENCE=
# ADMIN_ISSUER=
# ADMIN_JWKS_URI=

# --- Demo signing key -------------------------------------------------------------
# Unset, the service generates an ephemeral RSA key and logs a warning. That is correct locally:
# tokens die with the process. Set it only to reproduce something needing a key stable across
# restarts, and generate your own - never copy a deployed environment's.
# DEMO_SIGNING_KEY_JWK={"kty":"RSA",...}

# --- Fixtures ----------------------------------------------------------------------
# Committed fixtures are seeded on first boot for any URN with nothing published. false shows you
# how a genuinely empty environment behaves.
# RECORDING_SEED_FIXTURES=false

# --- Server ---------------------------------------------------------------------------
# SERVER_PORT=8080
