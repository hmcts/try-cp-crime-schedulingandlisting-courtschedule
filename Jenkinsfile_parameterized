#!groovy
@Library('Infrastructure') _

properties([
    parameters([
        choice(name: 'ENVIRONMENT', defaultValue: 'sandbox', choices: 'sandbox', description: 'Environment to deploy infrastructure to'),
    ])
])

withParameterizedPipeline('java', 'amp', 'try-slc', params.ENVIRONMENT, 'sandbox') {
  // Sandbox's vault is amp-try-slc-sbox, not amp-try-slc-sandbox: sandbox.tfvars overrides
  // vault_name, because Key Vault names are globally unique and short.
  afterSuccess('buildinfra:sandbox') {
    sh './bin/ensure-demo-signing-key.sh amp-try-slc-sbox'
  }
}
